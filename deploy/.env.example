# Coolify env template for multi-tenant production deploy.
# Copy to .env.production (gitignored). NEVER commit real secrets.

# --- Postgres ---
POSTGRES_USER=open_design
POSTGRES_DB=open_design
POSTGRES_PASSWORD=replace-with-strong-random-secret
DATABASE_URL=postgres://open_design:replace-with-strong-random-secret@postgres:5432/open_design
OD_PG_SSL=disable

# --- Cookie session auth (HIVEMIND-style; no Supabase) ---
# 32+ random bytes; rotate to invalidate all sessions.
OD_SESSION_SECRET=replace-with-32-plus-byte-random-string
# Set to 1 only for local HTTP dev. Production must keep cookies Secure.
OD_COOKIE_INSECURE=
# Enable POST /api/v1/auth/signup. Keep 0 in single-tenant deploy.
OD_SIGNUP_ENABLED=0

# --- First-boot admin seed (idempotent) ---
OD_SEED_ADMIN_EMAIL=admin@blaiq.ai
OD_SEED_ADMIN_PASSWORD=admin123
OD_SEED_ADMIN_DISPLAY_NAME=Admin
OD_SEED_TENANT_NAME=BLAIQ

# --- CORS / domains (strict, no wildcards in production) ---
OD_ALLOWED_ORIGINS=https://app.your-domain.com
APP_DOMAIN=app.your-domain.com
API_DOMAIN=api.your-domain.com

# --- Shared LLM provider keys (tenants never see these) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Container tuning ---
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest
OPEN_DESIGN_PORT=7456
OPEN_DESIGN_MEM_LIMIT=1g
NODE_OPTIONS=--max-old-space-size=512
