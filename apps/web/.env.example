# Vercel project env template. Copy values into Vercel Project Settings -> Environment Variables.

# Origin of the daemon API (Coolify-hosted). Must be same registrable
# domain as the web app so the cookie session works (app.<domain> +
# api.<domain> share <domain>). Include scheme, no trailing slash.
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Output mode: 'server' on Vercel so server components + auth work.
OD_WEB_OUTPUT_MODE=server
