# BLAIQ Coolify environment variables.
# Copy to .env.coolify and fill in real secrets before `docker compose -f docker-compose.coolify.yml up`.

# Postgres superuser password for the shared open-design database.
OD_PG_PASSWORD=changeme

# Anthropic API key used by both the BLAIQ daemon and the Ops Brain sidecar.
ANTHROPIC_API_KEY=

# Shared trust token between the BLAIQ daemon proxy (apps/daemon/src/admin/admin-routes.ts)
# and the Ops Brain sidecar (AI-company). The daemon attaches this on every
# proxied request; the sidecar rejects requests whose token does not match.
# Generate with: openssl rand -hex 32
OPS_BRAIN_TRUST_TOKEN=changeme
